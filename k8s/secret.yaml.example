# Template de referência — NÃO é aplicado diretamente.
# O Secret real é criado via `kubectl create secret generic`
# (deploy-aws.yml), com os valores vindos dos GitHub Secrets
# (JWT_SECRET, RDS_DATASOURCE_URL, RDS_USERNAME, RDS_PASSWORD,
# NEW_RELIC_LICENSE_KEY — os 3 do RDS são enviados automaticamente pelo
# terraform-apply.yml do inventory-database-infrastructure), nunca commitado
# com valores reais.
apiVersion: v1
kind: Secret
metadata:
  name: app-secret
  namespace: inventory
type: Opaque
stringData:
  JWT_SECRET: CHANGE_ME
  SPRING_DATASOURCE_URL: "jdbc:postgresql://CHANGE_ME.rds.amazonaws.com:5432/inventory_db"
  SPRING_DATASOURCE_USERNAME: CHANGE_ME
  SPRING_DATASOURCE_PASSWORD: CHANGE_ME
  NEW_RELIC_LICENSE_KEY: CHANGE_ME
